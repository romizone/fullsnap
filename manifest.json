{
  "manifest_version": 3,
  "name": "FullSnap – Screenshot Seluruh Halaman",
  "short_name": "FullSnap",
  "version": "1.1.1",
  "description": "Tangkap seluruh halaman web, area terlihat, atau area pilihan. Edit, beri anotasi, lalu simpan ke PNG, JPG, PDF, atau salin ke clipboard.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "downloads", "notifications", "clipboardWrite"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "FullSnap – Tangkap layar",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "capture-full": {
      "suggested_key": { "default": "Alt+Shift+1" },
      "description": "Tangkap seluruh halaman"
    },
    "capture-visible": {
      "suggested_key": { "default": "Alt+Shift+2" },
      "description": "Tangkap area terlihat"
    },
    "capture-selection": {
      "suggested_key": { "default": "Alt+Shift+3" },
      "description": "Tangkap area pilihan"
    }
  }
}
